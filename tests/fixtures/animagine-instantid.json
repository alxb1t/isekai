{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load Checkpoint (Animagine XL 4.0)"},
    "inputs": {"ckpt_name": "animagineXL40.safetensors"}
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": {"title": "Load Reference Face"},
    "inputs": {"image": "example.png", "upload": "image"}
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive Prompt"},
    "inputs": {"text": "1girl, anime, masterpiece", "clip": ["4", 1]}
  },
  "12": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative Prompt"},
    "inputs": {"text": "lowres, bad anatomy", "clip": ["4", 1]}
  },
  "13": {
    "class_type": "InstantIDModelLoader",
    "_meta": {"title": "Load InstantID Model"},
    "inputs": {"instantid_file": "ip-adapter.bin"}
  },
  "14": {
    "class_type": "InstantIDFaceAnalysis",
    "_meta": {"title": "InstantID Face Analysis"},
    "inputs": {"provider": "CUDA"}
  },
  "15": {
    "class_type": "ControlNetLoader",
    "_meta": {"title": "Load ControlNet (InstantID)"},
    "inputs": {"control_net_name": "instantid/diffusion_pytorch_model.safetensors"}
  },
  "16": {
    "class_type": "ApplyInstantID",
    "_meta": {"title": "Apply InstantID"},
    "inputs": {
      "instantid": ["13", 0],
      "insightface": ["14", 0],
      "control_net": ["15", 0],
      "image": ["10", 0],
      "model": ["4", 0],
      "positive": ["11", 0],
      "negative": ["12", 0],
      "weight": 0.8,
      "start_at": 0.0,
      "end_at": 1.0
    }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty Latent Image"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "3": {
    "class_type": "KSampler",
    "_meta": {"title": "KSampler"},
    "inputs": {
      "model": ["16", 0],
      "positive": ["16", 1],
      "negative": ["16", 2],
      "latent_image": ["5", 0],
      "seed": 42,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "VAE Decode"},
    "inputs": {"samples": ["3", 0], "vae": ["4", 2]}
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save Image"},
    "inputs": {"images": ["8", 0], "filename_prefix": "anime"}
  }
}
