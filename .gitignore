# Local config & secrets — NEVER commit
.env

# MinionsFactory: run artifacts out, gate config in.
# The glob must be `.minions/*`, not `.minions/` — git cannot re-include a
# file whose parent directory is itself excluded, so the negation below
# would never fire.
.minions/*
!.minions/minions.toml

# Written per-machine by Claude Code; contains this operator's absolute paths.
# CLAUDE.md makes "no absolute vault path in this public repo" an invariant, so
# the repo enforces it here rather than relying on a personal global ignore.
.claude/settings.local.json

# Downloaded model weights (tens of GB; live on the RunPod network volume)
models/

# Everything the staged pipeline captures or generates (design.md D14)
.data

# The render path's own two roots, which v0.13 deliberately left in place.
# `isekai/cli.py` still defaults `--output` to `./outputs`, and
# `baseline/build_contact_sheets.py` reads renders from `outputs/baseline` and
# *source photographs* from `.inputs/baseline` — so both hold personal
# photographs by construction, exactly as `.data/` does. D14's "nothing is
# generated outside the one ignored root" becomes true when v0.14 deletes the
# path that writes them; until then these two lines are what makes the standing
# rule hold, and they go in the same commit that deletes their producers.
outputs/
.inputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

.runpod_pod_id

.ruff_cache
.pytest_cache
