# Local config & secrets — NEVER commit
.env

# MinionsFactory: run artifacts out, gate config in.
# The glob must be `.minions/*`, not `.minions/` — git cannot re-include a
# file whose parent directory is itself excluded, so the negation below
# would never fire.
.minions/*
!.minions/minions.toml

# Written per-machine by Claude Code; contains this operator's absolute paths.
# CLAUDE.md makes "no absolute vault path in this public repo" an invariant, so
# the repo enforces it here rather than relying on a personal global ignore.
.claude/settings.local.json

# Downloaded model weights (tens of GB; live on the RunPod network volume)
models/

# Generated outputs
outputs/
.inputs/
# ANCHORED with a leading slash. Bare `inputs/` matches at any depth and excludes
# the DIRECTORY `prototype/inputs` -- and git never descends into an excluded
# directory, so the `!` negation below would silently do nothing.
/inputs/

# `prototype/inputs/` holds round 3's held-out portraits and the real photographs
# (D14). Its CONTENTS are ignored rather than the directory itself: git does not
# descend into an excluded directory, so `!.../README.md` below would do nothing
# if the parent were excluded. The README is the sourcing criteria and is tracked.
prototype/inputs/*
!prototype/inputs/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

.runpod_pod_id

.ruff_cache
.pytest_cache

# The prototype's two output trees, split by what it costs to make one again.
# Neither is committed: renders depict people (design.md D14) and derived/ is a
# few minutes of CPU away from being rebuilt.
#
#   renders/  PAID   — a pod session per run, and GPU nondeterminism (±2/255)
#                      means a re-render is not the same file. Irreplaceable.
#   derived/  FREE   — thumbnails, contact sheets, scores. Rebuilt from renders/.
prototype/renders/
prototype/derived/
# `prototype/inputs/` is NOT excluded here -- it is handled above as
# `prototype/inputs/*` plus a negation, which only works if the directory itself
# stays visible to git. A second bare rule here would silently defeat it.

# Prototype: third-party renders, not ours to redistribute. Digests in MANIFEST.md
prototype/archive/fotor/

# Evaluation runs: each is a self-contained directory holding COPIES of its
# inputs (photographs, renders) beside its results, so a finding can be re-read
# without resolving paths into trees that may have moved. Copies mean bulk --
# hundreds of MB per run -- and none of it is anything git should carry.
prototype/evaluations/

# Round 1's contact images -- 7.3 MB of derived PNGs whose findings are in
# FINDINGS.md (F12, F17, F18). They lived under the ignored `out/` tree until
# 2026-09-10; archiving them must not quietly turn them into commits.
prototype/archive/galleries/
# The real subject's criteria sheets. A DIRECTORY, not a name glob: the sheets
# sat at the root under the subject's own name until 2026-09-10, and a glob that no longer
# matches fails silently and open -- a real person's transcription becomes
# committable and nothing says so.
prototype/sheets/real/
