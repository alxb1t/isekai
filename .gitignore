# Local config & secrets — NEVER commit
.env

# MinionsFactory: run artifacts out, gate config in.
# The glob must be `.minions/*`, not `.minions/` — git cannot re-include a
# file whose parent directory is itself excluded, so the negation below
# would never fire.
.minions/*
!.minions/minions.toml

# Written per-machine by Claude Code; contains this operator's absolute paths.
# CLAUDE.md makes "no absolute vault path in this public repo" an invariant, so
# the repo enforces it here rather than relying on a personal global ignore.
.claude/settings.local.json

# Downloaded model weights (tens of GB; live on the RunPod network volume)
models/

# Everything the staged pipeline captures or generates (design.md D14)
.data

# `outputs/` is gone. It had two producers: the render path v0.14 deletes, and
# `baseline/build_contact_sheets.py`, which v0.14 repoints under `.data/` — so
# D14's "nothing generated is outside the one ignored root" is now literally
# true, rather than true of the pipeline and not of the labelling aid beside it.
#
# `.inputs/` stays, and v0.13's comment here was wrong to schedule it for
# deletion. It holds *source photographs* an operator puts there by hand, which
# is an input rather than something generated, so it is outside D14's claim
# entirely — and it holds a person's likeness exactly as `.data/` does, which is
# why the line is load-bearing.
.inputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS / editor cruft
.DS_Store
.idea/
.vscode/

.runpod_pod_id

.ruff_cache
.pytest_cache
