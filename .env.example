# Copy to .env and fill in. .env is gitignored and is the only place secrets
# and machine-local values live; this file declares SHAPE ONLY -- no real key,
# no real id, no path off this machine.

# --- RunPod deploy config ---
# API key and network volume id come from the RunPod console.
RUNPOD_API_KEY=""
RUNPOD_VOLUME_ID=""

# GPU tier to request, and the datacenter the volume lives in. The tier is
# swappable; the datacenter must match the volume's, or the pod cannot mount it.
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 4090"
RUNPOD_DATACENTER=""
