# Copy this file to `.env` (gitignored) and fill in for your machine.
# `.env` holds local paths and secrets and must NEVER be committed.

# --- Obsidian vault paths (where the plan lives and learning notes are written) ---
VAULT_PLAN="/path/to/vault/Lab/Photo to anime/implementation_plan.md"
VAULT_SCHEMA="/path/to/vault/CLAUDE.md"
VAULT_LAB_DIR="/path/to/vault/Lab/Photo to anime"
VAULT_LEARNING_DIR="/path/to/vault/Learning/Tech"

# --- RunPod deploy config (filled in at Phase 3) ---
RUNPOD_API_KEY=""
RUNPOD_VOLUME_ID=""
RUNPOD_GPU_TYPE="NVIDIA GeForce RTX 4090"
RUNPOD_DATACENTER=""
